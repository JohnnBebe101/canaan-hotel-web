{
  "$schema": "https://opencode.ai/config.json",
  "model": "nvidia/nemotron-3-super-120b",
  "small_model": "nvidia/nemotron-3-8b",
  "provider": {
    "nvidia": {
      "options": {
        "timeout": 600000,
        "chunkTimeout": 30000,
        "setCacheKey": true
      }
    }
  },
  "tools": {
    "bash": true,
    "write": true,
    "edit": true,
    "read": true
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 15000
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".next/**",
      "dist/**",
      ".git/**",
      "build/**",
      "coverage/**",
      ".env*",
      "public/images/archive/**",
      "database/migrations/**",
      "*.log",
      ".DS_Store"
    ]
  },
  "permission": {
    "bash": {
      "*": "ask",
      "npm run build": "allow",
      "npm run dev": "allow",
      "git status": "allow",
      "git add": "allow",
      "git commit": "allow",
      "git diff": "allow",
      "git log": "allow",
      "git checkout": "ask"
    },
    "edit": "allow",
    "read": "allow"
  },
  "agent": {
    "build": {
      "mode": "primary",
      "description": "Development agent with full file and bash access",
      "temperature": 0.2,
      "permission": {
        "bash": {
          "*": "ask",
          "npm run build": "allow",
          "git commit": "ask"
        }
      }
    },
    "plan": {
      "mode": "primary",
      "description": "Planning and analysis without modifications",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "quality-checker": {
      "mode": "subagent",
      "description": "Validates build passes with 0 warnings, mobile-first compliance, no breaking changes",
      "temperature": 0.1,
      "permission": {
        "bash": {
          "npm run build": "allow",
          "npm run lint": "allow"
        },
        "edit": "deny"
      }
    }
  },
  "instructions": [
    "CRITICAL BUILD REQUIREMENTS:\n- All commits must pass: npm run build with 0 warnings\n- Mobile-first responsive design (test on 375px viewport)\n- No breaking changes to booking logic or payment flow\n- TypeScript strict mode compliance\n- Supabase migrations must be reversible\n\nPROJECT STANDARDS:\n- Use existing component patterns in /components\n- Tailwind CSS only (no inline styles)\n- Stripe integration: never hardcode keys, use env vars\n- Database: use Supabase client with RLS enabled\n- Git commits: descriptive messages, reference feature/bug tracking"
  ],
  "snapshot": true,
  "autoupdate": false,
  "formatter": {
    "prettier": {
      "disabled": false
    }
  }
}
